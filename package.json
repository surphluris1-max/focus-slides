{
  "name": "focus-slides",
  "version": "1.0.0",
  "description": "Fullscreen focus timer with a slideshow, an alarm face and a break-mode bubble map",
  "author": "Uru",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.uru.focusslides",
    "productName": "Focus Slides",
    "files": ["main.js", "preload.js", "index.html", "style.css", "app.js", "assets/**/*"],
    "linux": { "target": "AppImage", "category": "Utility" },
    "win": { "target": "nsis" }
  }
}
